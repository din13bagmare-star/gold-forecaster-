  window.clearDiagnostics = clearDiagnostics;
  window.executeForecastPipeline = async function () {
    hideError();
    const btn = document.getElementById("runForecastBtn");
    const apiKey = (document.getElementById("apiKeyInput").value || "").trim() || (localStorage.getItem(STORAGE_KEY) || "").trim();
    const targetDateStr = (document.getElementById("targetDateInput").value || "").trim();
    const pathCount = Number(document.getElementById("simPathsSelect").value) || 2000;
    if (!apiKey) { showError("Please enter your Gemini API key in the vault box above and tap Save Key."); return; }
    localStorage.setItem(STORAGE_KEY, apiKey);
    if (!targetDateStr) { showError("Please select a valid target prediction date."); return; }
    const now = new Date(), todayStr = now.toISOString().slice(0, 10), istTimestamp = now.toLocaleString("en-IN", { timeZone: "Asia/Kolkata" }) + " IST";
    const horizonDays = Math.round((new Date(targetDateStr + "T00:00:00") - new Date(todayStr + "T00:00:00")) / 86400000);
    if (!Number.isFinite(horizonDays) || horizonDays < 1 || horizonDays > 90) { showError("Target date must be between 1 and 90 days ahead of today (" + todayStr + ")."); return; }
    btn.disabled = true; setStatus("Discovering available search-grounded Gemini models and fetching live market data..."); logDiag("Starting forecast pipeline for target date " + targetDateStr + " (" + horizonDays + " days)...");
    try {
      let discovered = [];
      try { discovered = await discoverModels(apiKey); logDiag("Discovered " + discovered.length + " candidate generateContent models."); } catch (listErr) { logDiag("Model discovery warning: " + (listErr.message || String(listErr))); }
      const queue = [], merged = PREFERRED_SEARCH_MODELS.concat(discovered);
      for (let i = 0; i < merged.length; i++) { const id = merged[i]; if (id && isCandidateSearchModel(id) && queue.indexOf(id) === -1) queue.push(id); }
      const promptText = buildMarketPrompt(todayStr, istTimestamp, targetDateStr, horizonDays);
      let marketData = null, usedModel = ""; const failures = [];
      for (let i = 0; i < queue.length; i++) {
        const modelId = queue[i];
        try { setStatus("Querying live web & institutional data via " + modelId + "..."); logDiag("Attempt " + (i + 1) + "/" + queue.length + " using model '" + modelId + "'..."); marketData = await invokeGroundedModel(apiKey, modelId, promptText); usedModel = modelId; logDiag("Succeeded with model '" + modelId + "'."); break; }
        catch (modelErr) { const msg = modelErr && modelErr.message ? modelErr.message : String(modelErr); failures.push(msg); logDiag("Failed on '" + modelId + "': " + msg.slice(0, 220)); const code = modelErr && modelErr.status; if (code === 401 || code === 403 || code === 429) throw modelErr; }
      }
      if (!marketData) throw new Error("All candidate models failed:\n" + failures.join("\n"));
