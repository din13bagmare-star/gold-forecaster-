    document.getElementById("projLocalSub").innerHTML = "Today: " + formatINR(meta.todayInr) + " | Expected Shift: <strong class='" + (deltaInr >= 0 ? "pos" : "neg") + "'>" + dSign + formatINR(Math.abs(deltaInr)) + " (" + pSign + deltaPct.toFixed(2) + "%)</strong>";
    document.getElementById("mcBandSummary").innerHTML = "<strong>" + mc.pathCount.toLocaleString("en-US") + "-Path 80% Confidence Band (" + meta.targetDateStr + "):</strong> " + formatINR(mc.p10Inr10g) + " (P10 Low) &nbsp;&bull;&nbsp; <strong>" + formatINR(mc.expectedInr10g) + " (P50 Median)</strong> &nbsp;&bull;&nbsp; " + formatINR(mc.p90Inr10g) + " (P90 High)";
    const treeEl = document.getElementById("scenarioTreeContainer"); treeEl.innerHTML = "";
    const scenarios = normalizeScenarioWeights(data.scenarios, spotUsd, spotFx);
    for (let i = 0; i < scenarios.length; i++) {
      const sc = scenarios[i] || {}, scInr = computeLandedIndia24KPer10g(sc.target_usd_oz, sc.target_usd_inr, meta.dutyRate, DEFAULT_GST_RATE, meta.basisInr);
      const item = document.createElement("div"); item.className = "scenario-item";
      item.innerHTML = "<strong>" + (sc.name || "Scenario " + (i + 1)) + " (" + (Number(sc.prob_pct) || 0) + "%): " + formatINR(scInr) + " / 10g</strong> &mdash; " + formatUSD(sc.target_usd_oz, 0) + "/oz | USD/INR Rs." + (Number(sc.target_usd_inr) || "--") + "<div class='muted-note' style='color:#cbd5e1;margin-top:4px;'>" + (sc.drivers || "") + "</div>";
      treeEl.appendChild(item);
