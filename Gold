    document.getElementById("mcResultCard").style.display = "block";
    document.getElementById("telemetryStamp").textContent = "Model: " + meta.usedModel + " | " + meta.istTimestamp;
    document.getElementById("horizonBadge").textContent = meta.horizonDays + " Days (" + meta.todayStr + " to " + meta.targetDateStr + ")";
  }
  window.handleSaveKey = function () {
    const val = (document.getElementById("apiKeyInput").value || "").trim();
