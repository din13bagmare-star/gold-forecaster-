      const dutyRate = Number.isFinite(Number(marketData.india_duty_decimal)) ? Number(marketData.india_duty_decimal) : 0.06;
      const basisInr = Number.isFinite(Number(marketData.mcx_comex_basis_inr)) ? Number(marketData.mcx_comex_basis_inr) : 1000;
      const parityToday = computeLandedIndia24KPer10g(spotUsd, spotFx, dutyRate, DEFAULT_GST_RATE, basisInr);
      const todayInr = Number(marketData.today_india_24k_10g) > 0 ? Number(marketData.today_india_24k_10g) : parityToday;
      logDiag("Running " + pathCount + "-path correlated Monte Carlo parity engine...");
      const mcResult = runCorrelatedMonteCarloEngine({ spotUsd: spotUsd, spotFx: spotFx, todayInr: todayInr, horizonDays: horizonDays, dutyRate: dutyRate, gstRate: DEFAULT_GST_RATE, basisInr: basisInr, pathCount: pathCount, scenarios: marketData.scenarios, annualGoldVol: marketData.annual_gold_vol, annualFxVol: marketData.annual_fx_vol, goldFxCorr: marketData.gold_fx_corr });
      renderDashboard(marketData, mcResult, { todayStr: todayStr, istTimestamp: istTimestamp, targetDateStr: targetDateStr, horizonDays: horizonDays, dutyRate: dutyRate, basisInr: basisInr, todayInr: todayInr, usedModel: usedModel });
      setStatus("Live web grounding + " + pathCount.toLocaleString("en-US") + "-path Monte Carlo forecast completed via " + usedModel + "."); logDiag("Forecast rendered successfully.");
    } catch (err) { const errMsg = err && err.message ? err.message : String(err); showError(errMsg); setStatus("Forecast failed."); logDiag("ERROR: " + errMsg); }
    finally { btn.disabled = false; }
  };
